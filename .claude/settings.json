{
  "permissions": {
    "allow": [
      "Bash(npm install*)",
      "Bash(npm run *)",
      "Bash(npx *)",
      "Bash(node *)",
      "Bash(tsc *)",
      "Bash(psql *)",
      "mcp__plugin_serena_serena__*",
      "mcp__plugin_context7_context7__*"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "f=$(jq -r '.tool_input.file_path'); echo \"$f\" | grep -qE '(^|/)\\.env(\\.|$)' && echo \"BLOCK: $f is an .env file — must not be edited by Claude\" && exit 1 || exit 0"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "f=$(jq -r '.tool_response.filePath // .tool_input.file_path'); [ -n \"$f\" ] && npx biome check --write --files-ignore-unknown=true \"$f\" 2>/dev/null; true"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "context7@claude-plugins-official": true,
    "ui-ux-pro-max@ui-ux-pro-max-skill": true,
    "skill-creator@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": true,
    "code-review@claude-plugins-official": true,
    "code-simplifier@claude-plugins-official": true,
    "pr-review-toolkit@claude-plugins-official": true,
    "security-guidance@claude-plugins-official": true,
    "serena@claude-plugins-official": true,
    "ralph-loop@claude-plugins-official": true,
    "feature-dev@claude-plugins-official": true,
    "commit-commands@claude-plugins-official": true,
    "vcsdd@vcsdd-claude-code": true,
    "claude-code-setup@claude-plugins-official": true,
    "voltagent-domains@voltagent-subagents": true,
    "voltagent-data-ai@voltagent-subagents": true,
    "voltagent-lang@voltagent-subagents": true,
    "voltagent-infra@voltagent-subagents": true,
    "voltagent-qa-sec@voltagent-subagents": true,
    "voltagent-core-dev@voltagent-subagents": true,
    "frontend-design@claude-plugins-official": true,
    "superpowers@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "chrome-devtools-mcp@claude-plugins-official": true,
    "playwright@claude-plugins-official": true,
    "firecrawl@claude-plugins-official": true,
    "sourcegraph@claude-plugins-official": true,
    "andrej-karpathy-skills@karpathy-skills": true
  }
}
