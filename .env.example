# If you store secrets as 1Password references (op://...), Docker Compose does not resolve
# them. Always start the stack with: npm run docker:up  OR  bash scripts/docker-compose-op.sh up --build
# (requires 1Password CLI signed in). Plain `docker compose up` will pass op:// strings through
# unchanged and Postgres/API will fail with errors mentioning op:// in role names or URLs.

# PostgreSQL credentials (used by Docker Compose and DATABASE_URL)
POSTGRES_DB=hayane
POSTGRES_USER=hayane
POSTGRES_PASSWORD=changeme

# PostgreSQL connection string
# Docker Compose: constructed from POSTGRES_USER/PASSWORD/DB above
# Local dev:
DATABASE_URL=postgres://hayane:changeme@localhost:5432/hayane

# Discord OAuth application credentials
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=https://www.and--line.com/v1/auth/discord/callback

# Discord Bot (requires Bot token with Manage Roles permission in the target guild)
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
# Comma-separated Discord role IDs in the same order as PAYJP_PLAN_IDS (one role per plan)
DISCORD_PLAN_ROLE_IDS=

# PAY.JP credentials
PAYJP_SECRET_KEY=sk_test_
PAYJP_WEBHOOK_TOKEN=
# Set to "true" in production (live mode), "false" for test mode
PAYJP_LIVEMODE=false

# Comma-separated list of allowed PAY.JP plan IDs
PAYJP_PLAN_IDS=pln_xxx

# Comma-separated initial charge amounts in yen (positive integers), same order/count as PAYJP_PLAN_IDS
PAYJP_PLAN_INITIAL_CHARGE_AMOUNTS=1000

# Frontend base URL — must be a valid origin (scheme://host[:port], no trailing slash)
FRONTEND_BASE_URL=https://www.and--line.com

# Shared subscribe gate (optional). When SUBSCRIBE_GATE_CODE is non-empty, POST /v1/subscriptions requires __Host-access_gate
# (issued by POST /v1/access-gate/verify). Leave empty to disable the gate.
# Repo-root `.env` is loaded automatically for `tsx` (see packages/server/src/load-env.ts). You may use 1Password references (op://...);
# those are resolved when you start the process with `op run --env-file=.env -- ...` or via scripts/docker-compose-op.sh — not by Node alone.
SUBSCRIBE_GATE_CODE=
# Browser gate cookie Max-Age (seconds) — positive integer (same op:// note as above if using 1Password)
ACCESS_GATE_SESSION_TTL_SECONDS=86400

# Admin stack (admin.and--line.com) — see docs/ops/admin-console.md
ADMIN_FRONTEND_ORIGIN=https://admin.and--line.com

# Daily resync cron schedule (cron syntax)
DAILY_RESYNC_CRON=0 2 * * *

# Google Form cancellation (退会) — replace with real form URL/entry IDs for production; see README.md
GOOGLE_FORM_CANCEL_BASE_URL=https://docs.google.com/forms/d/e/test-form/viewform
GOOGLE_FORM_CANCEL_EMAIL_ENTRY_ID=1111111111
GOOGLE_FORM_CANCEL_TOKEN_ENTRY_ID=2222222222
GOOGLE_FORM_CANCEL_SECRET=dev-google-shared-secret-change-me
GOOGLE_FORM_CANCEL_TOKEN_SECRET=dev-google-token-secret-change-me
GOOGLE_FORM_CANCEL_TOKEN_TTL_SECONDS=900

# API server port (optional, default: 3000)
PORT=3000

# Frontend (Vite) — PAY.JP public key exposed to the browser
# Get from PAY.JP dashboard → API Keys → Public Key
VITE_PAYJP_PUBLIC_KEY=pk_test_
