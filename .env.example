# If you store secrets as 1Password references (op://...), Docker Compose does not resolve
# them. Always start the stack with: npm run docker:up  OR  bash scripts/docker-compose-op.sh up --build
# (requires 1Password CLI signed in). Plain `docker compose up` will pass op:// strings through
# unchanged and Postgres/API will fail with errors mentioning op:// in role names or URLs.

# PostgreSQL credentials (used by Docker Compose and DATABASE_URL)
POSTGRES_DB=hayane
POSTGRES_USER=hayane
POSTGRES_PASSWORD=changeme

# PostgreSQL connection string
# Docker Compose: constructed from POSTGRES_USER/PASSWORD/DB above
# Local dev:
DATABASE_URL=postgres://hayane:changeme@localhost:5432/hayane

# Discord OAuth application credentials
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=https://www.and--line.com/v1/auth/discord/callback

# Discord Bot (requires Bot token with Manage Roles permission in the target guild)
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
# Comma-separated Discord role IDs in the same order as PAYJP_PLAN_IDS (one role per plan)
DISCORD_PLAN_ROLE_IDS=

# PAY.JP credentials
PAYJP_SECRET_KEY=sk_test_
PAYJP_WEBHOOK_TOKEN=
# Set to "true" in production (live mode), "false" for test mode
PAYJP_LIVEMODE=false

# Comma-separated list of allowed PAY.JP plan IDs
PAYJP_PLAN_IDS=pln_xxx

# Frontend base URL — must be a valid origin (scheme://host[:port], no trailing slash)
FRONTEND_BASE_URL=https://www.and--line.com

# Daily resync cron schedule (cron syntax)
DAILY_RESYNC_CRON=0 2 * * *

# API server port (optional, default: 3000)
PORT=3000

# Frontend (Vite) — PAY.JP public key exposed to the browser
# Get from PAY.JP dashboard → API Keys → Public Key
VITE_PAYJP_PUBLIC_KEY=pk_test_
