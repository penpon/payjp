{
  "name": "hayane-payjp",
  "private": true,
  "workspaces": [
    "packages/*",
    "frontend",
    "admin-frontend"
  ],
  "scripts": {
    "test": "vitest run",
    "test:auth": "vitest run --project @hayane/auth-service",
    "test:billing": "vitest run --project @hayane/billing-service",
    "test:sync": "vitest run --project @hayane/sync-service",
    "test:frontend": "vitest run --project @hayane/frontend",
    "test:admin-server": "vitest run --config packages/admin-server/vitest.config.ts",
    "test:admin-frontend": "vitest run --config admin-frontend/vitest.config.ts",
    "lint": "biome check .",
    "format": "biome check --write .",
    "build:frontend": "npm -w frontend run build",
    "build:admin-frontend": "npm -w @hayane/admin-frontend run build",
    "check:payment-security": "tsx scripts/dev/check-payment-page-security.ts",
    "check:payment-security:live": "tsx scripts/dev/check-payment-page-security.ts --live",
    "docker:compose": "bash scripts/local/docker-compose-op.sh",
    "docker:up": "bash scripts/local/docker-compose-op.sh up --build",
    "docker:down": "bash scripts/local/docker-compose-op.sh down",
    "docker:logs": "bash scripts/local/docker-compose-op.sh logs -f",
    "resync": "npm run -w @hayane/server resync --",
    "invalidate-access-gate": "npm run -w @hayane/server invalidate-access-gate",
    "truncate-app-data": "npm run -w @hayane/server truncate-app-data --",
    "verify:truncate": "bash scripts/local/run-verify-truncate-app-data.sh",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:install": "playwright install --with-deps chromium",
    "clean": "rm -rf logs/nginx/* test-results/* playwright-report/* entities.json node_modules/.cache 2>/dev/null || true"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "@playwright/test": "^1.56.1",
    "@types/node": "^25",
    "lefthook": "^2.1.6",
    "tsx": "^4.21.0",
    "vitest": "^3.2.4"
  }
}
