{
  "name": "hayane-payjp",
  "private": true,
  "workspaces": [
    "packages/*",
    "frontend"
  ],
  "scripts": {
    "test": "vitest run",
    "test:auth": "vitest run --project @hayane/auth-service",
    "test:billing": "vitest run --project @hayane/billing-service",
    "test:sync": "vitest run --project @hayane/sync-service",
    "test:frontend": "vitest run --project @hayane/frontend",
    "lint": "biome check .",
    "format": "biome check --write .",
    "build:frontend": "npm -w frontend run build",
    "docker:compose": "bash scripts/docker-compose-op.sh",
    "docker:up": "bash scripts/docker-compose-op.sh up --build",
    "docker:down": "bash scripts/docker-compose-op.sh down",
    "docker:logs": "bash scripts/docker-compose-op.sh logs -f",
    "resync": "npm run -w @hayane/server resync --",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:install": "playwright install --with-deps chromium"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.11",
    "@playwright/test": "^1.56.1",
    "@types/node": "^25",
    "lefthook": "^2.1.5",
    "vitest": "^4.1.4"
  }
}
