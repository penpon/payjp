# /etc/payjp-ops/.env — non-secret runtime configuration.
# Install as 0640 root:payjp-ops.
#
# Secrets (two Discord webhooks, one per channel) are NOT here: they are
# encrypted via systemd-creds and surfaced at runtime under
# $CREDENTIALS_DIRECTORY/DISCORD_OPS_WEBHOOK_ALERTS
# $CREDENTIALS_DIRECTORY/DISCORD_OPS_WEBHOOK_NORMAL
# See docs/ops/alerts.md for bootstrap steps (systemd-creds encrypt +
# LoadCredentialEncrypted). alerts = critical/warn/OPS_STORM, normal =
# RESOLVED + daily digest.

# Postgres access for `docker exec payjp-db-1 psql`. Not secret (DB user / DB name).
# Match the app's .env values.
POSTGRES_USER=
POSTGRES_DB=

# Operational paths.
# NOTE: BACKUP_DIR is NOT listed here. It is pinned in the service unit
# (ReadWritePaths=/var/backups/payjp-db) and in scripts/ops/backup-db.sh.
# Do not re-introduce a BACKUP_DIR= override here: it would diverge from
# ReadWritePaths and cause a silent "Read-only file system" failure.
BACKUP_RETENTION_DAYS=14
NGINX_VOLUME=payjp_nginx_logs
COMPOSE_PROJECT=payjp
HEALTH_URL=https://api.and--line.com/health
CERT_PATHS=/etc/letsencrypt/live/www.and--line.com/fullchain.pem
FAIL2BAN_JAILS=sshd nginx-444 nginx-limit-req
