# /etc/payjp-ops/env — install as 0400 root:root. DO NOT COMMIT ACTUAL TOKENS.
# Managed via deploy/ops-systemd/install.sh (seeds this template when absent).

# 1Password service account token (read-only access to ops webhook item)
OP_SERVICE_ACCOUNT_TOKEN=

# 1Password reference for the Discord webhook URL
OP_WEBHOOK_ITEM=op://Private/ops-discord-webhook/url

# Postgres credentials for `docker exec payjp-db-1 psql` (Phase C)
# Fetch via:  op read op://Private/payjp-db/user  and  ...pg/db
PGUSER=
PGDB=

# Operational paths (override per-host if needed)
BACKUP_DIR=/var/backups/hayane
NGINX_VOLUME=payjp_nginx_logs
COMPOSE_PROJECT=payjp
HEALTH_URL=https://api.and--line.com/health
CERT_PATHS=/etc/letsencrypt/live/www.and--line.com/fullchain.pem
FAIL2BAN_JAILS=sshd nginx-444 nginx-limit-req
