# /etc/payjp-ops/.env — consumed by `op run --env-file=...`.
# op:// references are resolved at invocation via the 1P service account
# token provided separately in /etc/payjp-ops/op-token.
# DO NOT put OP_SERVICE_ACCOUNT_TOKEN in this file — it goes in op-token.
# Install as 0640 root:payjp-ops.

# Discord webhook URL (secret) — use an op:// reference like:
# DISCORD_OPS_WEBHOOK=op://ENV/<webhook-item-id>/credential
DISCORD_OPS_WEBHOOK=

# Postgres access for `docker exec payjp-db-1 psql`. These are not secrets
# (DB user / DB name) — populate with the same values as the app's .env.
POSTGRES_USER=
POSTGRES_DB=

# Operational paths (override per-host if needed)
BACKUP_DIR=/var/backups/hayane
NGINX_VOLUME=payjp_nginx_logs
COMPOSE_PROJECT=payjp
HEALTH_URL=https://api.and--line.com/health
CERT_PATHS=/etc/letsencrypt/live/www.and--line.com/fullchain.pem
FAIL2BAN_JAILS=sshd nginx-444 nginx-limit-req
