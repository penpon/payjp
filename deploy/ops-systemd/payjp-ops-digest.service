[Unit]
Description=PAY.JP ops daily digest
Documentation=file:///home/ubuntu/payjp/docs/ops/alerts.md
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=payjp-ops
Group=payjp-ops
# See payjp-ops-check.service for secret-handling rationale. Digest posts
# exclusively to the normal channel (read-at-leisure), so only the normal
# credential is loaded.
EnvironmentFile=/etc/payjp-ops/.env
LoadCredentialEncrypted=DISCORD_OPS_WEBHOOK_NORMAL:/etc/payjp-ops/creds/DISCORD_OPS_WEBHOOK_NORMAL
# B2 read-only credential enables the offsite bucket size probe in
# gather_offsite(). One `rclone size` call per day is negligible on class C
# free tier (2500/day). Credential is read-only + bucket-scoped, lowest-risk
# leak surface among B2 keys.
LoadCredentialEncrypted=B2_DRILL_KEY_ID:/etc/payjp-ops/creds/B2_DRILL_KEY_ID
LoadCredentialEncrypted=B2_DRILL_APPLICATION_KEY:/etc/payjp-ops/creds/B2_DRILL_APPLICATION_KEY
ExecStart=/opt/payjp-ops/bin/daily-digest.sh
TimeoutStartSec=120
LogLevelMax=info
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=yes
RestrictRealtime=yes
RestrictSUIDSGID=no
ReadWritePaths=/var/lib/payjp-ops /run/payjp-ops

[Install]
WantedBy=multi-user.target
